# ==========================================
# ASTRA Maritime & Multimodal Logistics Intelligence
# Environment Configuration Template
# ==========================================

# Server Port
PORT=8080
VITE_PORT=3000
NODE_ENV=development

# ShipFinder / AIS Marine Telemetry Provider
# (If omitted or invalid, ASTRA automatically falls back to the high-fidelity AIS Simulation Engine)
SHIPFINDER_API_KEY=your_shipfinder_api_key_here
SHIPFINDER_API_BASE=https://api.elaneglobal.com/v1

# TomTom Fleet & Traffic Intelligence (Live Truck Routing, ETAs & Traffic Flow)
TOMTOM_API_KEY=your_tomtom_api_key_here
TOMTOM_API_BASE=https://api.tomtom.com

# Intugine Inland Logistics Tracking (GPS, FASTag, SIM)
# (If omitted or invalid, ASTRA automatically falls back to TomTom or the high-fidelity Inland Truck Simulation Engine)
INTUGINE_API_KEY=your_intugine_api_key_here
INTUGINE_API_BASE=https://api.intugine.com/v1
